    <ProjectReference Include="..\..\src\PepperX.SqliteGate.Dapper\PepperX.SqliteGate.Dapper.csproj" />
    <ProjectReference Include="..\..\src\PepperX.SqliteGate.EFCore\PepperX.SqliteGate.EFCore.csproj" />
  </ItemGroup>

</Project>
